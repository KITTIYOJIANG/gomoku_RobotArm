{
  "schema_version": 1,
  "serial": {
    "default_port": "COM6",
    "baudrate": 115200,
    "write_timeout_seconds": 1.0
  },
  "camera": {
    "index": 0,
    "preferred_name": "USB 2.0 Camera",
    "width": 1280,
    "height": 720,
    "fps": 30
  },
  "timing": {
    "action_wait_margin_ms": 200,
    "vacuum_build_ms": 700,
    "release_ms": 700
  },
  "vision_config_path": "config/vision_config.json",
  "stage5": {
    "enabled": true,
    "default_dry_run": true,
    "click_threshold_ratio": 0.32,
    "calibration_path": "calibration/stage5_board_calibration.json",
    "board_span_cells": 8,
    "allow_motion_without_camera": false
  },
  "logs_dir": "logs"
}